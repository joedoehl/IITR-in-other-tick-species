install.packages("igraph")
install.packages("igraph")
# Load essential libraries
library(easypackages) # allows loading and installation of multiple packages in one go
libraries("AER", # Required for dispersiontest()
"ARTool", # Needed for the non-parametric alternative for the two-way mixed ANOVA
"bookdown", # Required for including citations
"broom", # required for glance()
"car", #
"chromote", # Helps with gtsave() function
"cleanr", # Required for check_file() function
"cocor", # Required for the comparition of correlations
"conflicted", # Creates an error were function name conflicts occur between packages and forces me to specifiy the package to use for the function
"cowplot", # Required for multiple plot panel arrangement
"coxphf", # Firth's penalized maximum likelihood bias reduction method for Cox regression
"data.table", # Required for some data conversions, e.g. "setkey"
"DescTools", # Required to get Mean rank differences from Dunn's test
"emmeans", # Required for estimated marginal means analyses
"epitools", # Required to caluclate the odds ratios for the chi square tests
# "forcats", # Required for factor level rearrangement via fct_relevel() function
"GGally", # Required for the ggpairs() function to assess the linearity assumption in the two-way repeated measures MANOVA
"ggfortify", #
"ggpubr", # For correlation analysis
"glmmTMB", # For additional generalized linear regression functions
"glmmADMB", # Required for zero-truncated Poisson / negative binomial regression
"grid",
"gridExtra", # Required to display multiple plots in the same image: grid.arrange()
"gt", # To make publication style tables
"gtsummary", # Contains summary functions to support gt package
"here", # Calls current project directory
"Hmisc", #
"imputeTS", # Required for the na_replace function
"janitor", # Required for extra function to manipulate the data
"knitr", # Helps with the pdf assembly
"LambertW", # Required for skewness and kurtosis correction
"lme4", # Required for the lmer() function
"lmerTest", # Needed for lmerTest() function; a wraper for the lmer() function of the lme4 package that produces p-values
"lsmeans", # Required for lsmeans() function
"magrittr", # Required for set_colnames()
"MANOVA.RM", # Required for functions for repeated measures MANOVA
"MASS", #
"metan", # Great package for descriptive statistics
"moments", # required for skewness(), kurtosis(), & jarque.test() functions
"multcomp", # Used in linear regression analysis for hierarchical analysis
"multcompView", #
"MuMIn", #
"mvoutlier", #
"NBZIMM", # (install using "remotes" package with command remotes::install_github("nyiuab/NBZIMM"))
"nlme", # Required from mixed effect models by lme() function
"nparLD", # Required for non-parametric mixed model tests
"npmv", # Required for non-parametric multivariate analysis
"openxlsx", # Required for getSheetNames()
"philentropy", # Required for KL() Kullback-Leibler Divergence
"PMCMRplus", # Required for post-hoc analysis of Friedman test
"pscl", # Required for zero-inflated models
"pwrss", # Required for power calculations
"RColorBrewer", # For color schemes in plots
"rcompanion", # Required for pairwiseNominalIndependence() & Scheirer–Ray–Hare Test
# "readr", #
"readxl", # Required for the read_xlsx function
"rJava", #
"rlist", # Required for list.append function
"rmarkdown", # Adds functionalitiesto Rmarkdown
"rstatix", # Required for RM two-way ANOVA assumption testing
"RVAideMemoire", # Required for mqqnorm() function
"scales", #
"sjmisc", # Required for e.g. replace_columns()
# "stringr", # Required for str_split_fixed() function
"survival", # Required for survival analysis; survdiff() function
"survminer", # Required for pairwise_survdiff() function
# "tibble", # Required for data table manipulations
"tidyverse", # Loads multiple important packages
"tiff", # Required to load tiff files into the markdown file
"tinytex", # Required for pdf conversion
"ULT", # Required for non-parametric multivariate analysis (install using "remotes" package with command remotes::install_github("jacobmaugoust/ULT"))
"vctrs", # Required for list_drop_empty function
"WRS2", # Required for robust ANOVA
"ymse", # Required for pairwise() (install using "remotes" package with command remotes::install_github("AkselA/R-ymse"))
"zoo") # Required for na.locf() function to replace "NA" with last value prior to "NA" streak
# Use this code and copy all package names into to generate a .bib file for all used packages
# knitr::write_bib(c(RLibraries), file = 'packages.bib')
# Set preferences for conflicted functions
conflict_prefer("%like%", "data.table")
conflict_prefer("expand", "tidyr")
conflict_prefer("select", "dplyr")
conflict_prefer("html", "gt")
conflict_prefer("VarCorr", "nlme")
conflicts_prefer(tidyr::replace_na)
conflicts_prefer(dplyr::filter)
